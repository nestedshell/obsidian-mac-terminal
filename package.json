{
  "name": "mac-terminal",
  "version": "1.0.0",
  "description": "Obsidian plugin for macOS: open a real terminal inside Obsidian, already in the current folder.",
  "private": true,
  "license": "MIT",
  "author": "nestedshell",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "install-plugin": "node scripts/install.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@xterm/headless": "6.0.0",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
